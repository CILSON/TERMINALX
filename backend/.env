# TerminalX Environment Configuration
# ─────────────────────────────────────

# Set to false for live market data via Yahoo Finance + RSS news
USE_MOCK_DATA=false

# Database (Phase 2 - not needed for MVP)
DATABASE_URL=postgresql+asyncpg://terminalx:terminalx@localhost:5432/terminalx

# Redis (required)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# API Keys (optional - enhances functionality)
GEMINI_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
COINGECKO_API_KEY=

# Intervals (seconds)
QUOTE_UPDATE_INTERVAL_MOCK=5
QUOTE_UPDATE_INTERVAL_LIVE=30
NEWS_FETCH_INTERVAL=300
ALERT_CHECK_INTERVAL=10
