# TerminalX Backend Configuration
# Copy this to .env and fill in your values

# Google Gemini API Key (optional - AI features work with fallbacks)
GEMINI_API_KEY=

# Data mode (true = use realistic mock data, false = live Yahoo Finance + Google News)
USE_MOCK_DATA=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (optional - not required for basic operation)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/terminalx

# Redis (optional - not required for basic operation)
# REDIS_URL=redis://localhost:6379/0

# News API key (optional)
# NEWSAPI_KEY=

# Alpha Vantage API key (optional)
# ALPHA_VANTAGE_KEY=
